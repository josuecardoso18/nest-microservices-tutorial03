{
  "name": "nest-microservices-tutorial03",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev:users": "nest start users --watch",
    "start:dev:orders": "nest start orders --watch",
    "start:dev:notifications": "nest start notifications --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "build": "nest build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "rabbitmq:setup": "node --env-file=.env scripts/setup-rabbitmq.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^6.8.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^0.10.9",
    "dotenv": "^16.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.15.30",
    "prisma": "^6.8.2",
    "typescript": "~5.7.3"
  }
}
